{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VaultMind: Run server (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host", "127.0.0.1",
        "--port", "8080",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "VaultMind: Run server (python -m app.main)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "justMyCode": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "8080", "HOST": "127.0.0.1" }
    }
  ]
}
